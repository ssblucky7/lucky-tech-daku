rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // All collections require authentication
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // User-specific data
    match /caresync_users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    
    match /caresync_appointments/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /caresync_medications/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /caresync_family_members/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /caresync_medical_reports/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /caresync_notifications/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /caresync_messages/{document} {
      allow read, write: if isAuthenticated();
    }
    
    match /caresync_user_activities/{document} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
